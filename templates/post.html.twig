{% extends "base.html.twig" %}

{% block title %}{{ post.title }} - Symphora Blog{% endblock %}

{% block content %}
    <a href="/">← Home</a>
    <article>
        <h1>{{ post.title }}</h1>
        <p><small>{{ post.date|date('F j, Y') }}</small></p>
        {% if post.author %}
            <p><small>by {{ post.author }}</small></p>
        {% endif %}
        <div>{{ post.content|raw }}</div>
        {% if post.tags %}
            <p>
                {% for tag in post.tags %}
                    <span>#{{ tag }}</span>
                {% endfor %}
            </p>
        {% endif %}
    </article>
{% endblock %}
