{% extends "base.html.twig" %}

{% block title %}Posts - Symphora Blog{% endblock %}

{% block content %}
    <h1>Symphora Blog</h1>
    {% if posts is empty %}
        <p>No posts yet.</p>
    {% else %}
        <ul>
            {% for post in posts %}
                <li>
                    <a href="/?post={{ post.slug }}">{{ post.title }}</a>
                    <small>{{ post.date|date('Y-m-d') }}</small>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
