{% extends "base.html.twig" %}

{% block title %}Home - Symphora Blog{% endblock %}

{% block body %}
<div style="max-width: 800px; margin: 0 auto; padding: 20px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <h1>Symphora Blog</h1>
        <div>
            {% if app.user %}
                <a href="{{ path('create') }}" style="padding: 10px 20px; background-color: #007bff; color: white; text-decoration: none; border-radius: 4px; margin-right: 10px;">New Post</a>
                <span style="margin-right: 15px;">Welcome, <strong>{{ app.user.username }}</strong>!</span>
                <a href="{{ path('app_logout') }}" style="color: #dc3545; text-decoration: none;">Logout</a>
            {% else %}
                <div>
                    <a href="{{ path('app_login') }}" style="padding: 10px 20px; background-color: #007bff; color: white; text-decoration: none; border-radius: 4px; margin-right: 10px;">Login</a>
                    <a href="{{ path('app_register') }}" style="padding: 10px 20px; background-color: #28a745; color: white; text-decoration: none; border-radius: 4px;">Register</a>
                </div>
            {% endif %}
        </div>
    </div>

    {% if posts %}
        <div>
            {% for post in posts %}
                <article style="padding: 20px; border: 1px solid #ddd; border-radius: 8px; margin-bottom: 20px;">
                    <h2 style="margin-top: 0;">{{ post.title }}</h2>
                    <p style="color: #666; font-size: 0.9em; margin-bottom: 15px;">
                        By <strong>{{ post.author }}</strong> on 
                        {% if post.date is string %}
                            {{ post.date }}
                        {% else %}
                            {{ post.date|date('Y-m-d H:i') }}
                        {% endif %}
                    </p>
                    <div style="margin-bottom: 15px;">
                        {{ post.content|raw }}
                    </div>
                    {% if post.images %}
                        <div style="margin-top: 15px; border-top: 1px solid #eee; padding-top: 15px;">
                            <p style="font-weight: bold; margin-bottom: 10px;">Images:</p>
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px;">
                                {% for image in post.images %}
                                    <img src="{{ image }}" alt="Post image" style="max-width: 100%; height: auto; border-radius: 4px;">
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </article>
            {% endfor %}
        </div>
    {% else %}
        <div style="text-align: center; padding: 40px; background-color: #f8f9fa; border-radius: 8px;">
            <p style="font-size: 1.1em; color: #666;">No posts yet. {% if app.user %}<a href="{{ path('create') }}">Create one now!</a>{% endif %}</p>
        </div>
    {% endif %}
</div>
{% endblock %}
