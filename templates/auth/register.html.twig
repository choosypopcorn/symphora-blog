{% extends "base.html.twig" %}

{% block title %}Register - Symphora Blog{% endblock %}

{% block body %}
<div style="max-width: 400px; margin: 50px auto; padding: 20px; border: 1px solid #ccc; border-radius: 8px;">
    <h1 style="text-align: center; margin-bottom: 30px;">Register</h1>

    {% if error %}
        <div style="background-color: #f8d7da; color: #721c24; padding: 12px; border-radius: 4px; margin-bottom: 20px;">
            {{ error }}
        </div>
    {% endif %}

    {% if success %}
        <div style="background-color: #d4edda; color: #155724; padding: 12px; border-radius: 4px; margin-bottom: 20px;">
            Registration successful! <a href="{{ path('app_login') }}">Login here</a>
        </div>
    {% endif %}

    <form method="post" action="{{ path('app_register') }}">
        <div style="margin-bottom: 15px;">
            <label for="username" style="display: block; margin-bottom: 5px; font-weight: bold;">Username:</label>
            <input type="text" id="username" name="username" required autofocus style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box;">
        </div>

        <div style="margin-bottom: 20px;">
            <label for="password" style="display: block; margin-bottom: 5px; font-weight: bold;">Password:</label>
            <input type="password" id="password" name="password" required style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box;">
        </div>

        <div style="margin-bottom: 20px;">
            <label for="password_confirm" style="display: block; margin-bottom: 5px; font-weight: bold;">Confirm Password:</label>
            <input type="password" id="password_confirm" name="password_confirm" required style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box;">
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('register') }}">

        <button type="submit" style="width: 100%; padding: 10px; background-color: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 16px; font-weight: bold;">
            Register
        </button>
    </form>

    <div style="margin-top: 20px; text-align: center;">
        <p>Already have an account? <a href="{{ path('app_login') }}">Login here</a></p>
    </div>
</div>
{% endblock %}
